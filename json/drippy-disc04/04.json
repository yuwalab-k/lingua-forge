{
  "id": "drippy-disc04/04",
  "title": "#04",
  "source": "DRIPPY DISC04",
  "fontSize": "大",
  "source_url": null,
  "sentences": [
    {
      "sentence_index": 0,
      "english_text": "A bird with two horns on its head landed next to Drippy, frightening him.",
      "japanese_text": null
    },
    {
      "sentence_index": 1,
      "english_text": "Hello, Raindrop.",
      "japanese_text": null
    },
    {
      "sentence_index": 2,
      "english_text": "Who are you?",
      "japanese_text": null
    },
    {
      "sentence_index": 3,
      "english_text": "I'm an owl, a horned owl.",
      "japanese_text": null
    },
    {
      "sentence_index": 4,
      "english_text": "Is this your first time at the zoo?",
      "japanese_text": null
    },
    {
      "sentence_index": 5,
      "english_text": "Yes.",
      "japanese_text": null
    },
    {
      "sentence_index": 6,
      "english_text": "Drippy told him.",
      "japanese_text": null
    },
    {
      "sentence_index": 7,
      "english_text": "The owl looked at him.",
      "japanese_text": null
    },
    {
      "sentence_index": 8,
      "english_text": "Do you know what a zoo is?",
      "japanese_text": null
    },
    {
      "sentence_index": 9,
      "english_text": "Drippy thought for a moment.",
      "japanese_text": null
    },
    {
      "sentence_index": 10,
      "english_text": "Of course I do.",
      "japanese_text": null
    },
    {
      "sentence_index": 11,
      "english_text": "A zoo is where all these animals are born.",
      "japanese_text": null
    },
    {
      "sentence_index": 12,
      "english_text": "The owl hooted.",
      "japanese_text": null
    },
    {
      "sentence_index": 13,
      "english_text": "Oh, you don't know anything about zoos, do you?",
      "japanese_text": null
    },
    {
      "sentence_index": 14,
      "english_text": "None of these animals were born here.",
      "japanese_text": null
    },
    {
      "sentence_index": 15,
      "english_text": "They were all captured and taken from their homes and brought here.",
      "japanese_text": null
    },
    {
      "sentence_index": 16,
      "english_text": "Really?",
      "japanese_text": null
    },
    {
      "sentence_index": 17,
      "english_text": "You mean they're prisoners?",
      "japanese_text": null
    },
    {
      "sentence_index": 18,
      "english_text": "That's right.",
      "japanese_text": null
    },
    {
      "sentence_index": 19,
      "english_text": "There are bars and moats so that they can't escape.",
      "japanese_text": null
    },
    {
      "sentence_index": 20,
      "english_text": "Drippy looked around at the animals with a new interest.",
      "japanese_text": null
    },
    {
      "sentence_index": 21,
      "english_text": "He wondered how they felt about being away from their homes and their mothers and fathers.",
      "japanese_text": null
    },
    {
      "sentence_index": 22,
      "english_text": "Drippy asked the owl.",
      "japanese_text": null
    },
    {
      "sentence_index": 23,
      "english_text": "Are you a prisoner?",
      "japanese_text": null
    },
    {
      "sentence_index": 24,
      "english_text": "No. I've just come to visit my brother.",
      "japanese_text": null
    },
    {
      "sentence_index": 25,
      "english_text": "They have him in a cage.",
      "japanese_text": null
    },
    {
      "sentence_index": 26,
      "english_text": "He's in the aviary.",
      "japanese_text": null
    },
    {
      "sentence_index": 27,
      "english_text": "You know what an aviary is, don't you?",
      "japanese_text": null
    },
    {
      "sentence_index": 28,
      "english_text": "Certainly.",
      "japanese_text": null
    },
    {
      "sentence_index": 29,
      "english_text": "It's green.",
      "japanese_text": null
    },
    {
      "sentence_index": 30,
      "english_text": "The owl hooted again.",
      "japanese_text": null
    },
    {
      "sentence_index": 31,
      "english_text": "Oh, green is a color.",
      "japanese_text": null
    },
    {
      "sentence_index": 32,
      "english_text": "The aviary is where they keep birds locked up.",
      "japanese_text": null
    },
    {
      "sentence_index": 33,
      "english_text": "Come with me and I'll show you.",
      "japanese_text": null
    },
    {
      "sentence_index": 34,
      "english_text": "Alright.",
      "japanese_text": null
    },
    {
      "sentence_index": 35,
      "english_text": "The owl picked Drippy up and put him on his back.",
      "japanese_text": null
    },
    {
      "sentence_index": 36,
      "english_text": "They flew into the air.",
      "japanese_text": null
    },
    {
      "sentence_index": 37,
      "english_text": "And a few moments later, when Drippy looked down, he could see hundreds of birds in a cage.",
      "japanese_text": null
    },
    {
      "sentence_index": 38,
      "english_text": "Oh, that's the aviary, the owl said.",
      "japanese_text": null
    },
    {
      "sentence_index": 39,
      "english_text": "And he swooped down to earth.",
      "japanese_text": null
    },
    {
      "sentence_index": 40,
      "english_text": "It was a large cage with hundreds of birds of every size and description from all over the world.",
      "japanese_text": null
    },
    {
      "sentence_index": 41,
      "english_text": "There were bluebirds and pink flamingos and green parrots.",
      "japanese_text": null
    },
    {
      "sentence_index": 42,
      "english_text": "And in front of each cage was a sign telling the name of the bird inside.",
      "japanese_text": null
    },
    {
      "sentence_index": 43,
      "english_text": "The owl explained to Drippy, These birds come from all over the world.",
      "japanese_text": null
    },
    {
      "sentence_index": 44,
      "english_text": "Some are from Africa and some are from Asia.",
      "japanese_text": null
    },
    {
      "sentence_index": 45,
      "english_text": "Some come from the desert and some come from the forest.",
      "japanese_text": null
    },
    {
      "sentence_index": 46,
      "english_text": "Oh, they are all brought here so that people can visit the zoo and stare at them.",
      "japanese_text": null
    },
    {
      "sentence_index": 47,
      "english_text": "Is that a good thing?",
      "japanese_text": null
    },
    {
      "sentence_index": 48,
      "english_text": "Not if you're a bird, the wise owl replied.",
      "japanese_text": null
    }
  ]
}