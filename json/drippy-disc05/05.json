{
  "id": "drippy-disc05/05",
  "title": "#05",
  "source": "DRIPPY DISC05",
  "source_url": null,
  "sentences": [
    {
      "sentence_index": 0,
      "english_text": "Far away, Mrs. Dewdrop and her husband, and all the little raindrops, watched in horror as the flames and smoke of the forest fire rose into the sky.",
      "japanese_text": null
    },
    {
      "sentence_index": 1,
      "english_text": "Dripi is in there.",
      "japanese_text": null
    },
    {
      "sentence_index": 2,
      "english_text": "And she started crying.",
      "japanese_text": null
    },
    {
      "sentence_index": 3,
      "english_text": "And there's no one to save him.",
      "japanese_text": null
    },
    {
      "sentence_index": 4,
      "english_text": "And the wind heard her, and zoomed down to her.",
      "japanese_text": null
    },
    {
      "sentence_index": 5,
      "english_text": "Why are you crying?",
      "japanese_text": null
    },
    {
      "sentence_index": 6,
      "english_text": "Because my son is in the forest fire.",
      "japanese_text": null
    },
    {
      "sentence_index": 7,
      "english_text": "The wind shook his head, and the tops of the trees swayed.",
      "japanese_text": null
    },
    {
      "sentence_index": 8,
      "english_text": "No, he's safe in the zoo.",
      "japanese_text": null
    },
    {
      "sentence_index": 9,
      "english_text": "I put him there myself.",
      "japanese_text": null
    },
    {
      "sentence_index": 10,
      "english_text": "Oh no, an owl flew him into the forest.",
      "japanese_text": null
    },
    {
      "sentence_index": 11,
      "english_text": "So he's disobeyed me again.",
      "japanese_text": null
    },
    {
      "sentence_index": 12,
      "english_text": "He promised he would stay there.",
      "japanese_text": null
    },
    {
      "sentence_index": 13,
      "english_text": "Will you help him?",
      "japanese_text": null
    },
    {
      "sentence_index": 14,
      "english_text": "Please don't let him die.",
      "japanese_text": null
    },
    {
      "sentence_index": 15,
      "english_text": "I don't know.",
      "japanese_text": null
    },
    {
      "sentence_index": 16,
      "english_text": "He's been very bad.",
      "japanese_text": null
    },
    {
      "sentence_index": 17,
      "english_text": "Please, for my sake.",
      "japanese_text": null
    },
    {
      "sentence_index": 18,
      "english_text": "And the wind felt so sorry for Mrs. Dewdrop that he said, All right, just this once.",
      "japanese_text": null
    },
    {
      "sentence_index": 19,
      "english_text": "But if he gets in trouble again, I am not going to help him.",
      "japanese_text": null
    },
    {
      "sentence_index": 20,
      "english_text": "Oh, thank you.",
      "japanese_text": null
    },
    {
      "sentence_index": 21,
      "english_text": "And the wind roared off toward the great forest fire.",
      "japanese_text": null
    }
  ]
}