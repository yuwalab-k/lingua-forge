{
  "id": "drippy-disc05/03",
  "title": "#03",
  "source": "DRIPPY DISC05",
  "source_url": null,
  "sentences": [
    {
      "sentence_index": 0,
      "english_text": "Far away, Mrs. Dewdrop was still searching for her missing son.",
      "japanese_text": null
    },
    {
      "sentence_index": 1,
      "english_text": "Has anyone seen Drippy?",
      "japanese_text": null
    },
    {
      "sentence_index": 2,
      "english_text": "She called.",
      "japanese_text": null
    },
    {
      "sentence_index": 3,
      "english_text": "And the birds and the animals felt sorry for Mrs. Dewdrop, and they tried to help her.",
      "japanese_text": null
    },
    {
      "sentence_index": 4,
      "english_text": "They kept spreading the word about Drippy until finally the news reached the snail.",
      "japanese_text": null
    },
    {
      "sentence_index": 5,
      "english_text": "I saw him, the snail said.",
      "japanese_text": null
    },
    {
      "sentence_index": 6,
      "english_text": "Where?",
      "japanese_text": null
    },
    {
      "sentence_index": 7,
      "english_text": "In the zoo.",
      "japanese_text": null
    },
    {
      "sentence_index": 8,
      "english_text": "Jumbo the elephant stabbed Drippy into the ground, and I gave Drippy a ride up on my back.",
      "japanese_text": null
    },
    {
      "sentence_index": 9,
      "english_text": "Mrs. Dewdrop was very excited.",
      "japanese_text": null
    },
    {
      "sentence_index": 10,
      "english_text": "At last, I found my son.",
      "japanese_text": null
    },
    {
      "sentence_index": 11,
      "english_text": "Where is he now?",
      "japanese_text": null
    },
    {
      "sentence_index": 12,
      "english_text": "I saw an owl pick him up.",
      "japanese_text": null
    },
    {
      "sentence_index": 13,
      "english_text": "I think he flew him into the forest.",
      "japanese_text": null
    },
    {
      "sentence_index": 14,
      "english_text": "And they both turned to look at the forest far away.",
      "japanese_text": null
    },
    {
      "sentence_index": 15,
      "english_text": "And as they looked, they could see the terrible flames shooting high into the air.",
      "japanese_text": null
    },
    {
      "sentence_index": 16,
      "english_text": "It's a forest fire!",
      "japanese_text": null
    },
    {
      "sentence_index": 17,
      "english_text": "And she began to cry, for she knew she would never see her son again.",
      "japanese_text": null
    },
    {
      "sentence_index": 18,
      "english_text": "Nothing could ever escape from a forest fire.",
      "japanese_text": null
    }
  ]
}