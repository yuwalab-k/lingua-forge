{
  "id": "drippy-disc10/07",
  "title": "#07",
  "source": "DRIPPY DISC10",
  "source_url": null,
  "sentences": [
    {
      "sentence_index": 0,
      "english_text": "Mrs. Dewdrop saw the bluebird coming, and in her heart, she felt that there was good news.",
      "japanese_text": null
    },
    {
      "sentence_index": 1,
      "english_text": "For bluebirds always bring good news.",
      "japanese_text": null
    },
    {
      "sentence_index": 2,
      "english_text": "And she was right.",
      "japanese_text": null
    },
    {
      "sentence_index": 3,
      "english_text": "We found your son!",
      "japanese_text": null
    },
    {
      "sentence_index": 4,
      "english_text": "He's safe!",
      "japanese_text": null
    },
    {
      "sentence_index": 5,
      "english_text": "Mrs. Dewdrop cried tears of joy.",
      "japanese_text": null
    },
    {
      "sentence_index": 6,
      "english_text": "That's wonderful!",
      "japanese_text": null
    },
    {
      "sentence_index": 7,
      "english_text": "Thank you so much!",
      "japanese_text": null
    },
    {
      "sentence_index": 8,
      "english_text": "Where is he?",
      "japanese_text": null
    },
    {
      "sentence_index": 9,
      "english_text": "He's on the stage, in a theater.",
      "japanese_text": null
    },
    {
      "sentence_index": 10,
      "english_text": "Mrs. Dewdrop was puzzled.",
      "japanese_text": null
    },
    {
      "sentence_index": 11,
      "english_text": "What's he doing on a stage?",
      "japanese_text": null
    },
    {
      "sentence_index": 12,
      "english_text": "He's doing an act with the seal.",
      "japanese_text": null
    },
    {
      "sentence_index": 13,
      "english_text": "You must bring him back to me.",
      "japanese_text": null
    },
    {
      "sentence_index": 14,
      "english_text": "I can't. Bluebirds aren't allowed in theaters.",
      "japanese_text": null
    },
    {
      "sentence_index": 15,
      "english_text": "Then how are we going to save him?",
      "japanese_text": null
    },
    {
      "sentence_index": 16,
      "english_text": "And they both sat there, thinking.",
      "japanese_text": null
    },
    {
      "sentence_index": 17,
      "english_text": "And suddenly Mrs. Dewdrop remembered her friend.",
      "japanese_text": null
    },
    {
      "sentence_index": 18,
      "english_text": "The wind will save him.",
      "japanese_text": null
    },
    {
      "sentence_index": 19,
      "english_text": "The wind can go anywhere.",
      "japanese_text": null
    },
    {
      "sentence_index": 20,
      "english_text": "And she called out to the wind, and he flew down to her side.",
      "japanese_text": null
    },
    {
      "sentence_index": 21,
      "english_text": "We found Drippy!",
      "japanese_text": null
    },
    {
      "sentence_index": 22,
      "english_text": "Was he back on the park bench?",
      "japanese_text": null
    },
    {
      "sentence_index": 23,
      "english_text": "No, the bluebird said.",
      "japanese_text": null
    },
    {
      "sentence_index": 24,
      "english_text": "He's on a stage, in a theater.",
      "japanese_text": null
    },
    {
      "sentence_index": 25,
      "english_text": "Will you bring him back to me?",
      "japanese_text": null
    },
    {
      "sentence_index": 26,
      "english_text": "The wind did not know what to say.",
      "japanese_text": null
    },
    {
      "sentence_index": 27,
      "english_text": "He was not sure that Drippy was ready to come home yet.",
      "japanese_text": null
    },
    {
      "sentence_index": 28,
      "english_text": "Drippy still had a lesson to learn.",
      "japanese_text": null
    },
    {
      "sentence_index": 29,
      "english_text": "But the wind did not want to disappoint Mrs. Dewdrop.",
      "japanese_text": null
    },
    {
      "sentence_index": 30,
      "english_text": "She had suffered so much already because of Drippy's thoughtlessness.",
      "japanese_text": null
    },
    {
      "sentence_index": 31,
      "english_text": "Will you?",
      "japanese_text": null
    },
    {
      "sentence_index": 32,
      "english_text": "Please?",
      "japanese_text": null
    },
    {
      "sentence_index": 33,
      "english_text": "I'll see what I can do.",
      "japanese_text": null
    },
    {
      "sentence_index": 34,
      "english_text": "And off the wind flew.",
      "japanese_text": null
    },
    {
      "sentence_index": 35,
      "english_text": "On his way to the theater, the wind was very busy.",
      "japanese_text": null
    },
    {
      "sentence_index": 36,
      "english_text": "He brought rain to a farm that needed it.",
      "japanese_text": null
    },
    {
      "sentence_index": 37,
      "english_text": "He blew pollen from one field of flowers to another.",
      "japanese_text": null
    },
    {
      "sentence_index": 38,
      "english_text": "He cooled off a poor family that was living in a small cottage.",
      "japanese_text": null
    },
    {
      "sentence_index": 39,
      "english_text": "And finally he reached the theater.",
      "japanese_text": null
    }
  ]
}