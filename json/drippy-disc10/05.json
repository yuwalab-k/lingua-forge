{
  "id": "drippy-disc10/05",
  "title": "#05",
  "source": "DRIPPY DISC10",
  "fontSize": "大",
  "source_url": null,
  "sentences": [
    {
      "sentence_index": 0,
      "english_text": "Who are you?",
      "japanese_text": null
    },
    {
      "sentence_index": 1,
      "english_text": "Drippy asked.",
      "japanese_text": null
    },
    {
      "sentence_index": 2,
      "english_text": "I'm a seal.",
      "japanese_text": null
    },
    {
      "sentence_index": 3,
      "english_text": "What's a seal?",
      "japanese_text": null
    },
    {
      "sentence_index": 4,
      "english_text": "Me.",
      "japanese_text": null
    },
    {
      "sentence_index": 5,
      "english_text": "What do you do?",
      "japanese_text": null
    },
    {
      "sentence_index": 6,
      "english_text": "I bark.",
      "japanese_text": null
    },
    {
      "sentence_index": 7,
      "english_text": "The seal barked for him.",
      "japanese_text": null
    },
    {
      "sentence_index": 8,
      "english_text": "And I play ball.",
      "japanese_text": null
    },
    {
      "sentence_index": 9,
      "english_text": "Where do you play ball?",
      "japanese_text": null
    },
    {
      "sentence_index": 10,
      "english_text": "On the stage, in front of an audience.",
      "japanese_text": null
    },
    {
      "sentence_index": 11,
      "english_text": "They love me.",
      "japanese_text": null
    },
    {
      "sentence_index": 12,
      "english_text": "Well, naturally Drippy wanted the audience to love him too.",
      "japanese_text": null
    },
    {
      "sentence_index": 13,
      "english_text": "May I play ball with you?",
      "japanese_text": null
    },
    {
      "sentence_index": 14,
      "english_text": "Certainly.",
      "japanese_text": null
    },
    {
      "sentence_index": 15,
      "english_text": "I'll be going on any minute now.",
      "japanese_text": null
    },
    {
      "sentence_index": 16,
      "english_text": "The seal's coat was very shiny and Drippy used it like a mirror to make sure that he was nice and shiny so that the audience could see how handsome he was.",
      "japanese_text": null
    },
    {
      "sentence_index": 17,
      "english_text": "The dancers finished their act.",
      "japanese_text": null
    },
    {
      "sentence_index": 18,
      "english_text": "It was time for the seal to go on.",
      "japanese_text": null
    },
    {
      "sentence_index": 19,
      "english_text": "The seal and his trainer walked out on the stage with Drippy on the seal's back.",
      "japanese_text": null
    },
    {
      "sentence_index": 20,
      "english_text": "The trainer threw a large beach ball up in the air and the seal caught it on his nose.",
      "japanese_text": null
    },
    {
      "sentence_index": 21,
      "english_text": "Alright.",
      "japanese_text": null
    },
    {
      "sentence_index": 22,
      "english_text": "The seal said to Drippy.",
      "japanese_text": null
    },
    {
      "sentence_index": 23,
      "english_text": "If you want to play ball, climb up on the ball.",
      "japanese_text": null
    },
    {
      "sentence_index": 24,
      "english_text": "This is going to be fun.",
      "japanese_text": null
    },
    {
      "sentence_index": 25,
      "english_text": "He climbed up on the ball to the very top.",
      "japanese_text": null
    },
    {
      "sentence_index": 26,
      "english_text": "When he got there, the seal started twisting his neck so that the ball began spinning.",
      "japanese_text": null
    },
    {
      "sentence_index": 27,
      "english_text": "Wait a minute.",
      "japanese_text": null
    },
    {
      "sentence_index": 28,
      "english_text": "I'm getting dizzy.",
      "japanese_text": null
    },
    {
      "sentence_index": 29,
      "english_text": "You wanted to play ball.",
      "japanese_text": null
    },
    {
      "sentence_index": 30,
      "english_text": "Let's play.",
      "japanese_text": null
    },
    {
      "sentence_index": 31,
      "english_text": "And he started spinning the ball faster.",
      "japanese_text": null
    },
    {
      "sentence_index": 32,
      "english_text": "Poor Drippy.",
      "japanese_text": null
    },
    {
      "sentence_index": 33,
      "english_text": "It was very hard to hold on to the ball, but he was determined not to let go.",
      "japanese_text": null
    },
    {
      "sentence_index": 34,
      "english_text": "He did not want to fly out into the orchestra again.",
      "japanese_text": null
    },
    {
      "sentence_index": 35,
      "english_text": "I'm not so sure I like being a star.",
      "japanese_text": null
    },
    {
      "sentence_index": 36,
      "english_text": "It's very hard work.",
      "japanese_text": null
    }
  ]
}