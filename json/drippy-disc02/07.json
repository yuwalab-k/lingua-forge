{
  "id": "drippy-disc02/07",
  "title": "#07",
  "source": "DRIPPY DISC02",
  "source_url": null,
  "sentences": [
    {
      "sentence_index": 0,
      "english_text": "The game had carried the butterflies away from the cornfield, high over the ocean.",
      "japanese_text": null
    },
    {
      "sentence_index": 1,
      "english_text": "And when Drippy looked down, he saw the frightening-looking water below him.",
      "japanese_text": null
    },
    {
      "sentence_index": 2,
      "english_text": "Help!",
      "japanese_text": null
    },
    {
      "sentence_index": 3,
      "english_text": "What if I fall in?",
      "japanese_text": null
    },
    {
      "sentence_index": 4,
      "english_text": "But the butterflies were too busy to hear him.",
      "japanese_text": null
    },
    {
      "sentence_index": 5,
      "english_text": "Mr. Wind!",
      "japanese_text": null
    },
    {
      "sentence_index": 6,
      "english_text": "Drippy yelled.",
      "japanese_text": null
    },
    {
      "sentence_index": 7,
      "english_text": "Help me!",
      "japanese_text": null
    },
    {
      "sentence_index": 8,
      "english_text": "Help!",
      "japanese_text": null
    },
    {
      "sentence_index": 9,
      "english_text": "But the wind was far away, blowing rain clouds over the desert, where they'd not had rain for a long time.",
      "japanese_text": null
    },
    {
      "sentence_index": 10,
      "english_text": "And he did not hear Drippy.",
      "japanese_text": null
    },
    {
      "sentence_index": 11,
      "english_text": "Drippy looked down at the ocean again, and he thought.",
      "japanese_text": null
    },
    {
      "sentence_index": 12,
      "english_text": ".",
      "japanese_text": null
    },
    {
      "sentence_index": 13,
      "english_text": ".",
      "japanese_text": null
    },
    {
      "sentence_index": 14,
      "english_text": "What if the butterflies drop me?",
      "japanese_text": null
    },
    {
      "sentence_index": 15,
      "english_text": "And the instant he thought of it, one of the butterflies missed him.",
      "japanese_text": null
    },
    {
      "sentence_index": 16,
      "english_text": "And Drippy felt himself falling through the air, down, down, down, toward the water.",
      "japanese_text": null
    },
    {
      "sentence_index": 17,
      "english_text": "At first, Drippy was frightened.",
      "japanese_text": null
    },
    {
      "sentence_index": 18,
      "english_text": "But then he thought.",
      "japanese_text": null
    },
    {
      "sentence_index": 19,
      "english_text": ".",
      "japanese_text": null
    },
    {
      "sentence_index": 20,
      "english_text": ".",
      "japanese_text": null
    },
    {
      "sentence_index": 21,
      "english_text": "Why am I frightened?",
      "japanese_text": null
    },
    {
      "sentence_index": 22,
      "english_text": "I can't drown.",
      "japanese_text": null
    },
    {
      "sentence_index": 23,
      "english_text": "I'm water, too.",
      "japanese_text": null
    },
    {
      "sentence_index": 24,
      "english_text": "Nothing can hurt me.",
      "japanese_text": null
    },
    {
      "sentence_index": 25,
      "english_text": "I'm Drippy, the brave raindrop.",
      "japanese_text": null
    },
    {
      "sentence_index": 26,
      "english_text": "And as he looked down, he saw something that made his little heart start pounding.",
      "japanese_text": null
    },
    {
      "sentence_index": 27,
      "english_text": "He couldn't believe what he was seeing.",
      "japanese_text": null
    },
    {
      "sentence_index": 28,
      "english_text": "For the moment before Drippy touched the water, something rose from the ocean.",
      "japanese_text": null
    },
    {
      "sentence_index": 29,
      "english_text": "And Drippy found himself staring into the biggest, sharpest teeth he'd ever seen.",
      "japanese_text": null
    },
    {
      "sentence_index": 30,
      "english_text": "A giant shark had come out of the water.",
      "japanese_text": null
    },
    {
      "sentence_index": 31,
      "english_text": "Before Drippy could escape, snap!",
      "japanese_text": null
    },
    {
      "sentence_index": 32,
      "english_text": "A huge mouth closed on him.",
      "japanese_text": null
    },
    {
      "sentence_index": 33,
      "english_text": "Drippy was inside the shark.",
      "japanese_text": null
    }
  ]
}