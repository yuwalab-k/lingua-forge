{
  "id": "drippy-disc02/03",
  "title": "#03",
  "source": "DRIPPY DISC02",
  "fontSize": "大",
  "source_url": null,
  "sentences": [
    {
      "sentence_index": 0,
      "english_text": "Now this was Drippy's chance to admit the truth.",
      "japanese_text": null
    },
    {
      "sentence_index": 1,
      "english_text": "But did he?",
      "japanese_text": null
    },
    {
      "sentence_index": 2,
      "english_text": "Not Drippy.",
      "japanese_text": null
    },
    {
      "sentence_index": 3,
      "english_text": "He lied again.",
      "japanese_text": null
    },
    {
      "sentence_index": 4,
      "english_text": "I finished school.",
      "japanese_text": null
    },
    {
      "sentence_index": 5,
      "english_text": "The Wind did not believe him.",
      "japanese_text": null
    },
    {
      "sentence_index": 6,
      "english_text": "Oh, really?",
      "japanese_text": null
    },
    {
      "sentence_index": 7,
      "english_text": "Are you telling the truth?",
      "japanese_text": null
    },
    {
      "sentence_index": 8,
      "english_text": "Oh, yes, Mr. Wind.",
      "japanese_text": null
    },
    {
      "sentence_index": 9,
      "english_text": "What did you learn in school?",
      "japanese_text": null
    },
    {
      "sentence_index": 10,
      "english_text": "What did I learn in school?",
      "japanese_text": null
    },
    {
      "sentence_index": 11,
      "english_text": "Yes.",
      "japanese_text": null
    },
    {
      "sentence_index": 12,
      "english_text": "Drippy had no idea what anyone learned in school.",
      "japanese_text": null
    },
    {
      "sentence_index": 13,
      "english_text": "So he said.",
      "japanese_text": null
    },
    {
      "sentence_index": 14,
      "english_text": ".",
      "japanese_text": null
    },
    {
      "sentence_index": 15,
      "english_text": ".",
      "japanese_text": null
    },
    {
      "sentence_index": 16,
      "english_text": "Everything.",
      "japanese_text": null
    },
    {
      "sentence_index": 17,
      "english_text": "Everything?",
      "japanese_text": null
    },
    {
      "sentence_index": 18,
      "english_text": "That's right.",
      "japanese_text": null
    },
    {
      "sentence_index": 19,
      "english_text": "The Wind decided to test Drippy.",
      "japanese_text": null
    },
    {
      "sentence_index": 20,
      "english_text": "Did they teach you the days of the week?",
      "japanese_text": null
    },
    {
      "sentence_index": 21,
      "english_text": "Drippy had never even heard of the days of the week.",
      "japanese_text": null
    },
    {
      "sentence_index": 22,
      "english_text": "Certainly, Mr. Wind.",
      "japanese_text": null
    },
    {
      "sentence_index": 23,
      "english_text": "All right.",
      "japanese_text": null
    },
    {
      "sentence_index": 24,
      "english_text": "What are they?",
      "japanese_text": null
    },
    {
      "sentence_index": 25,
      "english_text": "Drippy's little heart sank.",
      "japanese_text": null
    },
    {
      "sentence_index": 26,
      "english_text": "Then he remembered what he had learned from Leopy.",
      "japanese_text": null
    },
    {
      "sentence_index": 27,
      "english_text": "The days of the week are one, two, three, four.",
      "japanese_text": null
    },
    {
      "sentence_index": 28,
      "english_text": "Those aren't the days of the week.",
      "japanese_text": null
    },
    {
      "sentence_index": 29,
      "english_text": "Those are numbers.",
      "japanese_text": null
    },
    {
      "sentence_index": 30,
      "english_text": "Everyone should know the days of the week.",
      "japanese_text": null
    },
    {
      "sentence_index": 31,
      "english_text": "Otherwise, you'll never know what day it is.",
      "japanese_text": null
    },
    {
      "sentence_index": 32,
      "english_text": "Yes, sir.",
      "japanese_text": null
    },
    {
      "sentence_index": 33,
      "english_text": "Do you want me to teach you the days of the week?",
      "japanese_text": null
    },
    {
      "sentence_index": 34,
      "english_text": "Oh, yes, I do.",
      "japanese_text": null
    },
    {
      "sentence_index": 35,
      "english_text": "And Drippy meant it.",
      "japanese_text": null
    },
    {
      "sentence_index": 36,
      "english_text": "Because he intended to be the smartest raindrop that ever lived.",
      "japanese_text": null
    },
    {
      "sentence_index": 37,
      "english_text": "It was not because he cared about learning, but because he wanted to show off.",
      "japanese_text": null
    },
    {
      "sentence_index": 38,
      "english_text": "He wanted to show everyone how smart he was, which is certainly the wrong reason for learning anything.",
      "japanese_text": null
    },
    {
      "sentence_index": 39,
      "english_text": "All right.",
      "japanese_text": null
    },
    {
      "sentence_index": 40,
      "english_text": "We'll begin with Monday.",
      "japanese_text": null
    },
    {
      "sentence_index": 41,
      "english_text": "After that comes Tuesday, Wednesday, Thursday, Friday, Saturday, and Sunday.",
      "japanese_text": null
    },
    {
      "sentence_index": 42,
      "english_text": "Can you remember that?",
      "japanese_text": null
    },
    {
      "sentence_index": 43,
      "english_text": "Of course.",
      "japanese_text": null
    },
    {
      "sentence_index": 44,
      "english_text": "Monday, Friday, Tuesday, Thursday.",
      "japanese_text": null
    },
    {
      "sentence_index": 45,
      "english_text": "No, no, no, no. You have it all wrong.",
      "japanese_text": null
    },
    {
      "sentence_index": 46,
      "english_text": "What's the matter with you?",
      "japanese_text": null
    },
    {
      "sentence_index": 47,
      "english_text": "Now concentrate.",
      "japanese_text": null
    },
    {
      "sentence_index": 48,
      "english_text": "I'm going to say them once more.",
      "japanese_text": null
    },
    {
      "sentence_index": 49,
      "english_text": "Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, and Sunday.",
      "japanese_text": null
    },
    {
      "sentence_index": 50,
      "english_text": "Those are the seven days of the week.",
      "japanese_text": null
    },
    {
      "sentence_index": 51,
      "english_text": "Repeat them.",
      "japanese_text": null
    },
    {
      "sentence_index": 52,
      "english_text": "Drippy concentrated.",
      "japanese_text": null
    },
    {
      "sentence_index": 53,
      "english_text": "And this time, he named them correctly.",
      "japanese_text": null
    },
    {
      "sentence_index": 54,
      "english_text": "That's very, very good.",
      "japanese_text": null
    },
    {
      "sentence_index": 55,
      "english_text": "I'm so smart, I can count to a hundred, and I know all the days of the week.",
      "japanese_text": null
    },
    {
      "sentence_index": 56,
      "english_text": "What other raindrop can do that?",
      "japanese_text": null
    },
    {
      "sentence_index": 57,
      "english_text": "Hang on tight.",
      "japanese_text": null
    },
    {
      "sentence_index": 58,
      "english_text": "There's a boat in trouble off the coast of Japan.",
      "japanese_text": null
    },
    {
      "sentence_index": 59,
      "english_text": "I've got to rescue it.",
      "japanese_text": null
    },
    {
      "sentence_index": 60,
      "english_text": "The wind told Drippy.",
      "japanese_text": null
    },
    {
      "sentence_index": 61,
      "english_text": "And suddenly, they were racing across the sky, going higher and higher.",
      "japanese_text": null
    },
    {
      "sentence_index": 62,
      "english_text": "It was like riding a giant sled made of wind and stardust all over the big sky.",
      "japanese_text": null
    },
    {
      "sentence_index": 63,
      "english_text": "Whee!",
      "japanese_text": null
    },
    {
      "sentence_index": 64,
      "english_text": "This is fun.",
      "japanese_text": null
    },
    {
      "sentence_index": 65,
      "english_text": "Is that all you think about?",
      "japanese_text": null
    },
    {
      "sentence_index": 66,
      "english_text": "Having fun?",
      "japanese_text": null
    },
    {
      "sentence_index": 67,
      "english_text": "Don't you think about your mother and father and how worried they are about you?",
      "japanese_text": null
    },
    {
      "sentence_index": 68,
      "english_text": "Of course I do.",
      "japanese_text": null
    },
    {
      "sentence_index": 69,
      "english_text": "I think about them all the time.",
      "japanese_text": null
    },
    {
      "sentence_index": 70,
      "english_text": "And he let a tear come into his eye.",
      "japanese_text": null
    },
    {
      "sentence_index": 71,
      "english_text": "The truth was that Drippy did not think about them at all.",
      "japanese_text": null
    },
    {
      "sentence_index": 72,
      "english_text": "He only thought about himself, about how wonderful and brave he was.",
      "japanese_text": null
    },
    {
      "sentence_index": 73,
      "english_text": "He was in no hurry to go home.",
      "japanese_text": null
    },
    {
      "sentence_index": 74,
      "english_text": "He was too busy enjoying himself and having adventures.",
      "japanese_text": null
    },
    {
      "sentence_index": 75,
      "english_text": "He wished he understood what the Queen Bee meant when she told him how important he was, and that the world could not exist without him.",
      "japanese_text": null
    },
    {
      "sentence_index": 76,
      "english_text": "He decided to ask the wind, because the wind knew everything.",
      "japanese_text": null
    }
  ]
}